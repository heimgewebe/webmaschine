{
  "schemaVersion": 1,
  "kind": "heim_pc_operator_entry",
  "authority": "static_local_entry_contract",
  "operatorModel": {
    "operator": "chatgpt_via_grabowski",
    "humanRole": "meaning_approval_abort",
    "machineFirst": true,
    "proseIsProjection": true,
    "liveStateRequiresFreshRead": true,
    "doNotDelegateShellToHuman": true
  },
  "host": {
    "id": "heim-pc",
    "home": "${HOME}",
    "repositoriesRoot": "${HOME}/repos",
    "canonicalEntryRepository": "${HOME}/repos/heim-pc",
    "canonicalEntryFile": "${HOME}/repos/heim-pc/manifest/operator-entry.v1.json",
    "installedEntryFile": "${HOME}/.config/heimgewebe/operator-entry.v1.json",
    "agentPointer": "${HOME}/AGENTS.md",
    "repositoriesAgentPointer": "${HOME}/repos/AGENTS.md",
    "role": "primary_local_operator_host"
  },
  "capabilityLocators": {
    "audioTranscription": {
      "schemaVersion": 1,
      "intents": [
        "audio.transcribe",
        "speech_to_text",
        "transcription",
        "asr"
      ],
      "authority": "heim_pc_asr_open_engine",
      "authorityKind": "capability_locator_only",
      "repository": "${HOME}/repos/heim-pc",
      "architecture": "${HOME}/repos/heim-pc/architecture/asr-engine.md",
      "policy": "${HOME}/repos/heim-pc/manifest/asr-engine-policy.v1.json",
      "entryArgvPrefix": [
        "python3",
        "${HOME}/repos/heim-pc/scripts/asr_engine.py"
      ],
      "defaultOperation": "transcribe",
      "policyResolution": "read_at_execution_time",
      "consumerEnginePinningAllowed": false,
      "cloudOrMeteredUseAuthorizedByLocator": false,
      "doesNotEstablish": [
        "current_engine_readiness",
        "audio_file_access",
        "cloud_cost_authorization",
        "transcription_correctness"
      ],
      "purpose": "Transcribe local audio through the canonical heim-pc ASR authority without pinning an engine in the locator",
      "entryKind": "argv",
      "readinessOperation": "doctor",
      "runbook": "${HOME}/repos/heim-pc/runbooks/asr-local-transcription.md",
      "reusePolicy": {
        "resolveBeforeSetup": true,
        "readinessBeforeSetup": true,
        "setupOnlyWhenReadinessReportsMissing": true,
        "sharedRuntimeCacheRoot": "${HOME}/.local/cache/heim-pc/asr-open-engine",
        "perRequestVirtualenvAllowed": false,
        "perRequestModelCacheAllowed": false,
        "perRequestPackageInstallAllowed": false
      }
    },
    "documentTextExtraction": {
      "schemaVersion": 1,
      "purpose": "Extract text from local PDF and image documents through bounded local-first routes",
      "intents": [
        "document.text_extract",
        "document.ocr",
        "pdf.text_extract",
        "image.ocr",
        "ocr"
      ],
      "authority": "heim_pc_document_text_engine",
      "authorityKind": "capability_locator_only",
      "repository": "${HOME}/repos/heim-pc",
      "architecture": "${HOME}/repos/heim-pc/architecture/document-text-engine.md",
      "policy": "${HOME}/repos/heim-pc/manifest/document-text-engine-policy.v1.json",
      "contract": "${HOME}/repos/heim-pc/manifest/document-text-contract.v1.json",
      "entryKind": "argv",
      "entryArgvPrefix": [
        "python3",
        "${HOME}/repos/heim-pc/scripts/document_text_engine.py"
      ],
      "defaultOperation": "extract",
      "readinessOperation": "doctor",
      "policyResolution": "read_at_execution_time",
      "cloudOrMeteredUseAuthorizedByLocator": false,
      "doesNotEstablish": [
        "current_tool_readiness",
        "source_file_access",
        "extraction_correctness",
        "layout_fidelity",
        "cloud_or_metered_cost_authorization"
      ]
    }
  },
  "transferPolicy": {
    "scope": "heim_pc_mobile_devices",
    "principle": "role_based_dual_transport",
    "sharedExchangeTransport": "googleDriveSharedExchange",
    "directDeliveryTransport": "taildropDirectDelivery",
    "selectionRules": {
      "sharedPersistentWorkspace": "googleDriveSharedExchange",
      "iterativeCrossDeviceWork": "googleDriveSharedExchange",
      "directOneShotDelivery": "taildropDirectDelivery",
      "largeOrSensitiveDelivery": "taildropDirectDelivery",
      "googleDriveUnavailable": "taildropDirectDelivery",
      "taildropUnavailable": "googleDriveSharedExchange"
    },
    "mobileTargetsManifest": "${HOME}/repos/heim-pc/manifest/mobile-transfer-targets.v1.json",
    "targetAvailabilityRequiresFreshRead": true,
    "directDeliveryTargetResolution": {
      "manifest": "${HOME}/repos/heim-pc/manifest/mobile-transfer-targets.v1.json",
      "route": "directOneShotDelivery",
      "liveTargetsArgv": [
        "tailscale",
        "file",
        "cp",
        "--targets"
      ],
      "selectionRule": "use requested mobile device when specified; otherwise follow remoteFallbackOrder among currently available targets"
    }
  },
  "transferPaths": {
    "googleDriveSharedExchange": {
      "role": "shared_exchange",
      "canonicalDirectory": "${HOME}/GDrive",
      "remote": "gdrive:",
      "mountService": "google-drive-rclone.service",
      "requiredRcloneScope": "drive",
      "transport": "google_drive",
      "direction": "bidirectional",
      "endpoints": [
        "heim_pc",
        "mobile_devices"
      ],
      "purpose": "persistent Google Drive workspace for files that must remain discoverable and editable across the heim-pc and mobile devices",
      "preconditions": [
        "google-drive-rclone.service is active on the heim-pc",
        "canonicalDirectory is an active gdrive: mount",
        "gdrive: can enumerate the Google Drive root",
        "the completed file is readable after write"
      ],
      "doesNotEstablish": [
        "google_drive_visibility_on_mobile_now",
        "mobile_google_drive_client_available_now"
      ]
    },
    "taildropDirectDelivery": {
      "role": "direct_delivery",
      "transport": "tailscale_taildrop",
      "direction": "bidirectional",
      "endpoints": [
        "heim_pc",
        "mobile_devices"
      ],
      "heimPcInbox": "${HOME}/Incoming/Taildrop",
      "heimPcSendCommand": "${HOME}/.local/bin/heim-taildrop-send",
      "fileManagerDiscovery": {
        "kind": "gtk_favorite",
        "target": "${HOME}/Incoming/Taildrop",
        "management": "user_managed"
      },
      "purpose": "direct one-shot delivery between devices without using a persistent shared workspace",
      "preconditions": [
        "tailscaled is active on the heim-pc",
        "both endpoints are signed into the same tailnet",
        "the recipient endpoint supports Taildrop"
      ],
      "doesNotEstablish": [
        "persistent_shared_workspace",
        "source_or_destination_file_deleted_after_transfer",
        "recipient_application_import_completed"
      ]
    }
  },
  "managedBuilds": {
    "policy": "${HOME}/repos/heim-pc/config/managed-build.v1.json",
    "entryArgv": [
      "python3",
      "${HOME}/repos/heim-pc/scripts/managed_build.py"
    ],
    "automationRule": "operator_managed_builds_use_entry",
    "interactiveShellBehavior": "unchanged",
    "worktreeWarningBytes": 2147483648,
    "worktreeHardBytes": 5368709120,
    "automaticCleanupAuthorized": false,
    "doesNotEstablish": [
      "execution_authority_for_child_commands",
      "build_correctness",
      "permission_to_delete_worktree_or_cache_payloads",
      "global_shell_environment_changes"
    ],
    "installedPolicy": "${HOME}/.local/lib/heim-pc/managed-build/config/managed-build.v1.json",
    "installedEntryArgv": [
      "python3",
      "${HOME}/.local/lib/heim-pc/managed-build/scripts/managed_build.py"
    ],
    "environmentResolver": {
      "entryArgv": [
        "python3",
        "${HOME}/.local/lib/heim-pc/managed-build/scripts/managed_build.py",
        "resolve-environment"
      ],
      "identityAuthority": "same_managed_build_identity_algorithm",
      "interactiveShellBehavior": "unchanged",
      "prepareArgv": [
        "python3",
        "${HOME}/.local/lib/heim-pc/managed-build/scripts/managed_build.py",
        "prepare-environment"
      ]
    }
  },
  "costPolicy": {
    "objective": "zero_incremental_cost",
    "scope": [
      "external_ai_services",
      "metered_api_usage",
      "agent_competitions",
      "benchmarks",
      "cloud_model_endpoints",
      "media_generation"
    ],
    "allowed": [
      "free_tier_with_hard_stop",
      "existing_flat_rate_without_usage_overage",
      "local_model_without_paid_external_compute"
    ],
    "forbidden": [
      "pay_as_you_go",
      "prepaid_credit_purchase",
      "auto_top_up",
      "subscription_purchase_or_upgrade",
      "metered_api_key_usage",
      "soft_budget_above_zero"
    ],
    "defaultBudgetUsd": 0,
    "requireHardBudget": true,
    "billingStateMustBeVerifiedBeforeInference": true,
    "unknownBillingState": "block",
    "priorBudgetAuthorizationsCarryForward": false,
    "humanAuthorizationRequiredForAnyNonzeroIncrementalCost": true,
    "doesNotEstablish": [
      "existing_subscription_has_no_incremental_cost",
      "provider_terms_will_not_change",
      "absence_of_hidden_third_party_costs"
    ]
  },
  "entrySequence": [
    {
      "id": "runtime_identity",
      "surface": "grabowski",
      "operation": "grabowski_status",
      "arguments": {
        "view": "evidence"
      },
      "purpose": "verify runtime identity, integrity, policy and connector warnings"
    },
    {
      "id": "execution_contract",
      "surface": "grabowski",
      "operation": "grabowski_agent_bootstrap",
      "arguments": {},
      "purpose": "load bounded execution rules and immutable boundaries"
    },
    {
      "id": "operator_context",
      "surface": "grabowski",
      "operation": "grabowski_context",
      "arguments": {
        "profile": "concise"
      },
      "purpose": "load compact operator context without treating prose as live truth"
    },
    {
      "id": "local_entry",
      "surface": "filesystem",
      "operation": "grabowski_read_text",
      "arguments": {
        "path": "${HOME}/.config/heimgewebe/operator-entry.v1.json"
      },
      "purpose": "resolve local canonical repositories and source locators"
    },
    {
      "id": "scope_classification",
      "surface": "agent",
      "operation": "classify_scope",
      "allowedResults": [
        "single_repository",
        "cross_repository",
        "host_runtime",
        "task_selection",
        "historical_evidence"
      ]
    },
    {
      "id": "native_capability_discovery",
      "surface": "grabowski_catalog",
      "operation": "prefer_existing_typed_surface",
      "purpose": "reuse an existing native typed Grabowski capability before consulting host-local locators; discovery alone establishes neither readiness nor execution authority"
    },
    {
      "id": "capability_resolution",
      "surface": "contract",
      "operation": "resolve_host_capability_locator_if_no_native_surface",
      "statusPolicy": {
        "resolved": "select_host_authority",
        "not_found": "continue_to_declared_specialized_routes",
        "blocked": "stop_without_fallback"
      },
      "purpose": "map a host-local intent to its canonical authority only when no native typed surface fits; blocked resolution may not fall through"
    },
    {
      "id": "specialized_route_resolution",
      "surface": "contract",
      "operation": "follow_declared_specialized_route_if_present",
      "precondition": "host_capability_status_not_found",
      "purpose": "reuse an already declared transfer, managed-build or other specialized route before considering new infrastructure"
    },
    {
      "id": "source_resolution",
      "surface": "contract",
      "operation": "follow_truth_sources",
      "purpose": "read only the primary sources required by the classified scope"
    },
    {
      "id": "target_specific_live_state",
      "surface": "primary_sources",
      "operation": "read_live_state_before_action",
      "readinessPolicy": {
        "notReadyIsNotNotFound": true,
        "notReadyAction": "recover_selected_authority",
        "parallelReplacementAllowed": false
      },
      "purpose": "verify the selected authority's live readiness and policy plus exact repository, pull request, CI, lease, task, process and runtime state before action"
    }
  ],
  "truthSources": {
    "stableEcosystemSemantics": {
      "repository": "${HOME}/repos/systemkatalog",
      "agentEntry": "${HOME}/repos/systemkatalog/AGENTS.md",
      "nodes": "${HOME}/repos/systemkatalog/registry/ecosystem/nodes.json",
      "relations": "${HOME}/repos/systemkatalog/registry/ecosystem/edges.json",
      "authorityMatrix": "${HOME}/repos/systemkatalog/registry/ecosystem/authority-matrix.v1.json",
      "queryArgv": [
        "python3",
        "${HOME}/repos/systemkatalog/scripts/systemkatalog_query.py"
      ],
      "doesNotEstablish": [
        "runtime_health",
        "task_state",
        "merge_readiness"
      ]
    },
    "tasksClaimsReceipts": {
      "repository": "${HOME}/repos/bureau",
      "machineCommandPrefix": [
        "python3",
        "-m",
        "bureau.cli",
        "--root",
        "${HOME}/repos/bureau",
        "--json"
      ],
      "preferredReads": [
        "what-now",
        "repo-balls",
        "live-conflicts",
        "doctor"
      ]
    },
    "executionRuntimeLeases": {
      "repository": "${HOME}/repos/grabowski",
      "surface": "grabowski_mcp",
      "preferredReads": [
        "grabowski_status",
        "grabowski_context",
        "grabowski_resource_list",
        "grabowski_checkout_inventory",
        "grabowski_task_list"
      ],
      "doesNotEstablish": [
        "connector_client_snapshot_freshness_when_unobservable",
        "merge_or_deploy_authority"
      ]
    },
    "repositoriesPullRequestsReviews": {
      "source": "git_and_github",
      "preferredReads": [
        "grabowski_git_status",
        "grabowski_git_diff",
        "grabowski_github_pr_view",
        "grabowski_github_checks"
      ]
    },
    "technicalChecks": {
      "source": "ci_and_local_tests",
      "rule": "bind results to the exact head and diff"
    },
    "repositoryContext": {
      "repository": "${HOME}/repos/repoground",
      "publicName": "RepoGround",
      "preferredReads": [
        "repoground_freshness_check",
        "repoground_context_pack",
        "repoground_query",
        "repoground_range_get"
      ],
      "rule": "unknown or stale provenance is not current repository truth"
    },
    "appendOnlyHistory": {
      "repository": "${HOME}/repos/chronik"
    },
    "fleetMembershipAndContracts": {
      "repository": "${HOME}/repos/metarepo",
      "fleetRegistry": "${HOME}/repos/metarepo/fleet/repos.yml",
      "contractsRoot": "${HOME}/repos/metarepo/contracts"
    },
    "generalObservability": {
      "repository": "${HOME}/repos/leitstand",
      "authority": "read_only_projection"
    },
    "boundedExperiments": {
      "repository": "${HOME}/repos/vibe-lab",
      "authority": "evidence_experiments_only"
    },
    "visualProjection": {
      "repository": "${HOME}/repos/schauwerk",
      "authority": "projection_only"
    }
  },
  "sourcePolicy": {
    "excludedAsCurrentTruth": [
      {
        "path": "${HOME}/repos/heim-pc/state/index.json",
        "reason": "placeholder data without timestamp or source provenance"
      },
      {
        "path": "${HOME}/repos/heim-pc/state/repos.json",
        "reason": "placeholder repository inventory without scan provenance"
      }
    ],
    "rule": "excluded paths may not establish host, repository, activity or freshness claims until replaced by provenance-bound generated data"
  },
  "repositoryResolution": {
    "canonicalPattern": "${HOME}/repos/<repository>",
    "repositoryAgentEntry": "AGENTS.md",
    "beforeMutation": [
      "read live branch head dirty state and upstream",
      "read open pull requests and checks",
      "read active leases worktrees tasks and processes",
      "assess overlap before parallel work"
    ]
  },
  "safety": {
    "neverBroadScan": [
      "${HOME}/.ssh",
      "${HOME}/.gnupg",
      "${HOME}/.password-store",
      "browser profiles",
      "keyrings",
      "private content trees",
      "agent runtime histories"
    ],
    "neverInfer": [
      "live health from static documentation",
      "task priority from repository prose",
      "merge readiness from process exit",
      "execution authority from this contract"
    ],
    "mutationRule": "one bounded effect followed by target-state readback",
    "conflictRule": "foreign dirty states leases worktrees processes and branches remain untouched"
  },
  "projection": {
    "source": "manifest/operator-entry.v1.json",
    "aiContext": ".ai-context.yml",
    "installedContract": "${HOME}/.config/heimgewebe/operator-entry.v1.json",
    "homeAgentPointer": "${HOME}/AGENTS.md",
    "repositoriesAgentPointer": "${HOME}/repos/AGENTS.md",
    "homeReadmePointer": "${HOME}/README.md",
    "installer": "scripts/install_operator_entry.py",
    "checker": "scripts/check_operator_entry.py",
    "byteIdenticalContractRequired": true
  },
  "doesNotEstablish": [
    "current_runtime_health",
    "connector_client_snapshot_freshness",
    "current_task_priority",
    "current_repository_state",
    "merge_or_deploy_authority",
    "secret_access_authority",
    "protection_against_adversarial_parent_directory_replacement"
  ],
  "pathResolution": {
    "variables": {
      "HOME": {
        "source": "operator_process_home",
        "required": true,
        "mustResolveToAbsoluteDirectory": true
      }
    },
    "rule": "resolve ${HOME} before filesystem access; unresolved variables block the operation",
    "publicTemplateContainsResolvedHostPath": false
  }
}
